#!/usr/bin/env bash
set -u

if [[ $# -ne 1 ]]; then
  echo "Usage: $(basename "$0") <testname>" >&2
  exit 2
fi

TEST_NAME=$1
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

LANG_BIN=${LANG_BIN:-"$SCRIPT_DIR/../../lang"}

INFILE="$SCRIPT_DIR/${TEST_NAME}.lang"
CORRECT="$SCRIPT_DIR/${TEST_NAME}.correct"
OUTXML="$SCRIPT_DIR/out.xml"
OUTFMT="$SCRIPT_DIR/out2.xml"

"$LANG_BIN" "$INFILE" "$OUTXML"
RETVAL=$?

if [[ $RETVAL -ne 0 ]]; then
  cp "$OUTXML" "$OUTFMT"
else
  if command -v xmllint >/dev/null 2>&1; then
    xmllint --format "$OUTXML" -o "$OUTFMT"
    RETVAL=$?
    [[ $RETVAL -ne 0 ]] && echo "$TEST_NAME FAILED -----" && exit 1
  else
    cp "$OUTXML" "$OUTFMT"
  fi
fi

diff -qbwB "$OUTFMT" "$CORRECT"
RETVAL=$?
[[ $RETVAL -eq 0 ]] && echo "$TEST_NAME PASSED"
[[ $RETVAL -ne 0 ]] && echo "$TEST_NAME FAILED -----"
exit $RETVAL
